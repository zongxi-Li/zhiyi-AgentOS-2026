<mxfile host="65bd71144e">
    <diagram id="cognitive-planner-acg" name="认知规划引擎流程图">
        <mxGraphModel dx="1170" dy="1932" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="项目规划器：认知规划引擎生成 ACG 的流程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#1f2937;" parent="1" vertex="1">
                    <mxGeometry x="53" y="-54" width="512" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="start" value="开始" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="90" y="80" width="100" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="input" value="用户目标与任务上下文&lt;br&gt;&lt;font&gt;目标、偏好、业务场景、历史状态&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="180" width="200" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="environment" value="执行环境建模&lt;br&gt;&lt;font&gt;智能体池、工具、资源、记忆、外部系统&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="310" width="200" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="policy" value="运行约束输入&lt;br&gt;&lt;font&gt;预算、时延、权限、隐私、可靠性要求&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="450" width="200" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="engine_container" value="认知规划引擎（Workflow Engine 的认知决策核心）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#666666;arcSize=3;fontStyle=1;fontSize=16;fontColor=#111827;verticalAlign=top;spacingTop=12;" parent="1" vertex="1">
                    <mxGeometry x="300" y="120" width="871" height="771" as="geometry"/>
                </mxCell>
                <mxCell id="intent" value="1. 目标解释与意图建模&lt;br&gt;&lt;font&gt;识别显式目标、隐式意图、成功标准&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="350" y="190" width="190" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="decompose" value="2. 任务分解&lt;br&gt;&lt;font&gt;生成候选步骤、子目标与完成条件&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="610" y="190" width="190" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="dependency" value="3. 依赖与状态推理&lt;br&gt;&lt;font&gt;确定前置条件、共享状态、冲突关系&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="905" y="190" width="190" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="agent_match" value="4. 智能体能力匹配&lt;br&gt;&lt;font&gt;选择参与者、角色、责任边界&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e8f5e9;strokeColor=#43a047;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="350" y="340" width="190" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="topology" value="5. 协作拓扑构建&lt;br&gt;&lt;font&gt;建立智能体连接、监督关系与协商路径&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e8f5e9;strokeColor=#43a047;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="590" y="340" width="190" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sharing" value="6. 信息共享策略&lt;br&gt;&lt;font&gt;决定共享内容、粒度、时机与访问范围&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e8f5e9;strokeColor=#43a047;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="830" y="340" width="190" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="cost" value="7. 通信成本控制&lt;br&gt;&lt;font&gt;控制消息频率、上下文长度、同步/异步模式&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff3e0;strokeColor=#fb8c00;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="350" y="490" width="190" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="constraints" value="8. 运行约束编排&lt;br&gt;&lt;font&gt;预算、时延、权限、隐私、降级与回退&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff3e0;strokeColor=#fb8c00;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="590" y="490" width="190" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="validate" value="9. ACG 一致性校验&lt;br&gt;&lt;font&gt;检查可执行性、资源竞争、信息闭环与风险&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff3e0;strokeColor=#fb8c00;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="830" y="490" width="190" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="valid_decision" value="ACG 是否满足&lt;br&gt;任务目标与运行约束？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="610" y="650" width="230" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="acg_note" value="输出不是传统 DAG&lt;br&gt;&lt;font&gt;DAG 只描述任务依赖；ACG 同时描述任务、智能体、连接、共享信息与运行约束。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="90" width="350" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="acg_output" value="完整 ACG 蓝图&lt;br&gt;&lt;font&gt;• 节点：任务 / 智能体 / 工具 / 记忆 / 资源&lt;br&gt;• 边：控制流 / 数据流 / 通信流 / 协作关系&lt;br&gt;• 约束：预算 / 时延 / 权限 / 隐私 / 回退策略&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;fontStyle=1;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="230" width="370" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="scheduler" value="调度器接收蓝图&lt;br&gt;&lt;font&gt;生成执行队列、并发策略、资源分配方案&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="470" width="290" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="executor" value="执行器驱动群体协作&lt;br&gt;&lt;font&gt;智能体按 ACG 节点与边执行、通信、共享状态&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="610" width="290" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="monitor" value="运行监控与反馈&lt;br&gt;&lt;font&gt;进度、失败、成本漂移、上下文变化、智能体状态&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="760" width="330" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="replan_decision" value="是否需要动态调整&lt;br&gt;群体结构或规划？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="910" y="740" width="230" height="130" as="geometry"/>
