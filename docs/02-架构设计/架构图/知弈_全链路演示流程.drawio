<mxfile host="65bd71144e" pages="1">
    <diagram id="agentos-demo-vertical-flow" name="全链路演示流程竖版">
        <mxGraphModel dx="1433" dy="1094" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1080" pageHeight="2400" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="知弈 AgentOS 全链路演示流程" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#0b2545;" parent="1" vertex="1">
                    <mxGeometry x="207.5" y="68" width="700" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="stage1_band" value="第一段演示：用户业务入口" style="swimlane;html=1;startSize=36;rounded=1;horizontal=1;fillColor=#f3f8ff;strokeColor=#4f81bd;fontSize=15;fontStyle=1;arcSize=4;" parent="1" vertex="1">
                    <mxGeometry x="80" y="150" width="920" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="input_prompt" value="演示输入提示词&#xa;甲方委托乙方开发 CRM 系统，合同总价 100 万元。合同签署后甲方支付 30%，系统上线验收后支付 70%。乙方应在 60 日内完成开发并交付。合同未明确验收标准、需求变更流程、知识产权归属、数据安全责任和争议解决方式。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f81bd;fontSize=12;align=left;spacingLeft=12;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="120" y="205" width="840" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="frontend_contract" value="页面 1：/agentos/legal/contract-review&#xa;律师合同审查工作台&#xa;选择 Workflow: legal_contract_review_v1&#xa;点击“开始审查”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0ff;strokeColor=#4f81bd;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="120" y="330" width="265" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="business_outputs" value="可讲解内容&#xa;风险面板：验收标准 / 需求变更 / 知识产权 / 数据安全&#xa;Evidence 面板：本地知识库 + keyword 检索&#xa;报告预览：Markdown 审查报告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f81bd;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="420" y="330" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="business_message" value="讲解要点&#xa;先让评委看到系统解决什么问题：&#xa;专业任务从自然语言输入变成结构化风险、证据和报告。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f81bd;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="715" y="330" width="245" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="stage2_band" value="第二段演示：AgentOS Harness 生命周期治理" style="swimlane;html=1;startSize=36;rounded=1;horizontal=1;fillColor=#f1fbf7;strokeColor=#2e7d5b;fontSize=15;fontStyle=1;arcSize=4;" parent="1" vertex="1">
                    <mxGeometry x="80" y="500" width="920" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="api_start" value="Frontend → Java Gateway → Python FastAPI&#xa;POST /ai/core/workflows/start&#xa;title / domain=legal / intent=contract_review&#xa;workflowId=legal_contract_review_v1&#xa;reviewMode=human_in_loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d5b;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="120" y="555" width="255" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="runtime_core" value="WorkflowRuntime (Harness 核心)&#xa;create_task() → AgentTask&#xa;start() → WorkflowRun&#xa;_workflow_adapter() 按 runtimeEngine 选执行引擎&#xa;统一持有 Trace / Review / Checkpoint / Store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d5b;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="415" y="555" width="255" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="adapter_select" value="ExecutionAdapter 双执行路径&#xa;native：线性 YAML 流程&#xa;acg：Core Native ACG 就绪集调度&#xa;两者共享治理对象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d5b;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="705" y="555" width="255" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="acg_contract_flow" value="合同审查标准流程：runtimeEngine=acg&#xa;parse_contract → classify_clauses → risk_detect&#xa;→ legal_evidence_match → suggestion_generate&#xa;→ human_review → report_generate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d5b;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="120" y="720" width="390" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="review_gate" value="Human Review 关口&#xa;ACG reviewRequired=true&#xa;运行进入 waiting_review 并创建 Checkpoint&#xa;审核 approved 后按就绪集恢复 report_generate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e8;strokeColor=#c67c00;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="550" y="720" width="410" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="projector" value="ACGExecutor 统一回写 AgentOS 治理对象&#xa;WorkflowRun.steps / output.artifacts / Trace / Checkpoint / Provenance&#xa;status = waiting_review 或 completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d5b;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="120" y="855" width="840" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="stage3_band" value="第三段演示：Console 治理视角" style="swimlane;html=1;startSize=36;rounded=1;horizontal=1;fillColor=#fff8e8;strokeColor=#c67c00;fontSize=15;fontStyle=1;arcSize=4;" parent="1" vertex="1">
                    <mxGeometry x="80" y="980" width="920" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="console_page" value="页面 2：/agentos-console&#xa;查看同一个 WorkflowRun&#xa;WorkflowRunPanel / WorkflowStepList&#xa;TraceEventTimeline / CheckpointPanel / HumanReviewPanel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c67c00;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="120" y="1035" width="270" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="trace_checkpoint" value="治理三件套&#xa;Trace：19 种事件，记录 step_started / agent_called / review_decided / run_completed 等&#xa;Checkpoint：保存 run、input、output、steps 快照&#xa;Review：审核决策进入 REVIEW_DECIDED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c67c00;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="425" y="1035" width="265" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="console_message" value="讲解要点&#xa;AgentOS 的价值不是只给答案，&#xa;而是让专业任务有运行状态、审核点、恢复点和可导出的黑匣子记录。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c67c00;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="725" y="1035" width="235" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="console_note" value="答辩提示：合同审查页展示业务交付，Console 展示 Harness 工程治理；两者指向同一个 runId。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c67c00;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="120" y="1180" width="840" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="stage4_band" value="第四段演示：ACG 动态群体智能引擎" style="swimlane;html=1;startSize=36;rounded=1;horizontal=1;fillColor=#f7f3ff;strokeColor=#7e57c2;fontSize=15;fontStyle=1;arcSize=4;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1330" width="920" height="560" as="geometry"/>
                </mxCell>
                <mxCell id="acg_page" value="页面 3：/agentos/acg&#xa;输入合同文本&#xa;Workflow: legal_contract_review_v1&#xa;可勾选 usePlanner&#xa;勾选 faultInjection 演示自愈" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="120" y="1385" width="255" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="acg_blueprint" value="ACGBlueprint&#xa;6 类节点：Step / Agent / Skill / Memory / Evidence / Control&#xa;7 类边：Dependency / Communication / ControlFlow / Execution / Read / Write / Support&#xa;promote_workflow_to_acg() 可将线性工作流升格为图 IR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="410" y="1385" width="265" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="acg_executor" value="ACGExecutor._drive()&#xa;validate_blueprint()&#xa;ready_steps() 计算就绪集&#xa;asyncio.gather 并行执行 batch&#xa;completedStepIds / provenance 回写" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="710" y="1385" width="250" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="low_entropy" value="低熵通信&#xa;ContextAssembler 以 DEPENDENCY 上游为默认来源&#xa;按 input.fields / input.from 精准取字段&#xa;生成 ContextPack: data / tokensAvailable / tokensDelivered / savingRatio&#xa;Trace: DATA_CONSUMED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4ecff;strokeColor=#7e57c2;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="120" y="1545" width="390" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="provenance" value="数据血缘&#xa;ProvenanceLedger.record_production()&#xa;ProvenanceLedger.record_consumption()&#xa;记录下游消费了哪些上游字段&#xa;/acg 端点返回 provenance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="550" y="1545" width="410" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="fault_prompt" value="ACG 自愈演示输入&#xa;勾选：注入故障演示自愈&#xa;节点：risk_detect&#xa;故障类型：模型超时 timeout&#xa;max_triggers=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#d93025;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="120" y="1710" width="250" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="self_heal_flow" value="自愈闭环&#xa;FaultInjector.fire() → InjectedFault&#xa;STEP_FAILED → CheckpointStore.create()&#xa;step.status=PENDING / retryCount++&#xa;RUN_RECOVERED(strategy=local_replan)&#xa;下一轮 ready_steps 重新调度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f0;strokeColor=#d93025;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="410" y="1710" width="265" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="acg_observe" value="观察结果&#xa;ACG 拓扑：Step / Agent / Evidence / Memory 节点&#xa;低熵指标：Token 节省率&#xa;恢复轨迹：STEP_FAILED + RUN_RECOVERED&#xa;任务最终 completed，recoveryCount=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="710" y="1710" width="250" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="stage5_band" value="第五段演示：联邦学习与跨机构扩展" style="swimlane;html=1;startSize=36;rounded=1;horizontal=1;fillColor=#eef7f4;strokeColor=#3f6b63;fontSize=15;fontStyle=1;arcSize=4;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1940" width="920" height="177" as="geometry"/>
                </mxCell>
                <mxCell id="fed_page" value="页面 4：/federated-learning&#xa;联邦网络拓扑 / 训练曲线 / 模型聚合 / 隐私保护&#xa;用于展示跨机构协作能力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3f6b63;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="120" y="1995" width="255" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="fed_rag" value="联邦 RAG 优化&#xa;客户端上传 RAGStatistics：top_k / threshold / success_rate / avg_time&#xa;服务端聚合 balanced / precision / recall / speed / personalized 参数&#xa;原始文档和查询留在本地" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3f6b63;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="410" y="1995" width="265" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="fed_governance" value="治理增强&#xa;FederatedAdapter.get_risk_enhancement()&#xa;输出 risk_adjustment / confidence / federated_nodes_count&#xa;把联邦优化结果注入 AgentOS 风险治理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3f6b63;fontSize=12;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="710" y="1995" width="250" height="95" as="geometry"/>
