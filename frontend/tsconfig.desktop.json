{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["src/*"],
      "@platform": ["src/platform/desktop/adapter.ts"],
      "@tauri-apps/*": ["../desktop/node_modules/@tauri-apps/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["src/**/*.spec.ts"]
}
