# Production Docker Compose settings. Secret values stay in KINLIN_SECRETS_DIR.
KINLIN_DEPLOYMENT_ID=replace-with-stable-deployment-id
KINLIN_SECRETS_DIR=/etc/kinlin-ai/secrets
KINLIN_ENVIRONMENT=production
KINLIN_SPRING_PROFILE=prod
KINLIN_BIND_ADDRESS=127.0.0.1
KINLIN_HTTP_PORT=8080
KINLIN_PUBLIC_ORIGIN=http://127.0.0.1:8080
KINLIN_DB_NAME=kinlin_ai
KINLIN_DB_USER=kinlin_ai
KINLIN_DB_ADMIN_USER=postgres

# SQLite remains single-instance until PostgreSQL WorkflowStore is available.
AGENTOS_SQLITE_BUSY_TIMEOUT_MS=5000

# Optional production resource limits.
KINLIN_FRONTEND_CPUS=0.5
KINLIN_FRONTEND_MEMORY=256m
KINLIN_BACKEND_CPUS=2.0
KINLIN_BACKEND_MEMORY=2g
KINLIN_AI_CPUS=4.0
KINLIN_AI_MEMORY=4g
KINLIN_POSTGRES_CPUS=2.0
KINLIN_POSTGRES_MEMORY=2g
KINLIN_REDIS_CPUS=1.0
KINLIN_REDIS_MEMORY=512m

# Model and provider runtime settings. API keys remain external secret files.
TEXT_ENGINE=auto
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ENABLED=true
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash
GLM_ENABLED=true
GLM_NATIVE_SEARCH_ENABLED=true
GLM_WEB_SEARCH_URL=https://open.bigmodel.cn/api/paas/v4/web_search
GLM_WEB_READER_URL=https://open.bigmodel.cn/api/paas/v4/reader
GLM_WEB_SEARCH_ENGINE=search_std
GLM_WEB_SEARCH_CONTENT_SIZE=medium
GLM_WEB_SEARCH_RECENCY_FILTER=noLimit
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_BALANCED=qwen-plus
QWEN_ENABLED=true
AGENTOS_LLM_STREAM_JSON=true
AGENTOS_LLM_PLANNING_TIMEOUT_SECONDS=480
AGENTOS_LLM_PLANNING_TOTAL_TIMEOUT_SECONDS=660
AGENTOS_LLM_PLANNING_MAX_RETRIES=1
AGENTOS_LLM_PROVIDER=
AGENTOS_LLM_BASE_URL=
AGENTOS_LLM_MODEL=

PROVIDER_STATE_ENABLED=true
PROVIDER_STATE_TTL_SECONDS=3600
TOOL_RUNTIME_ENABLED=true
