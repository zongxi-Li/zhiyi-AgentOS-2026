# Non-secret Docker Compose configuration. Secret values live in KINLIN_SECRETS_DIR.
KINLIN_DEPLOYMENT_ID=kinlin-dev-yourname
KINLIN_SECRETS_DIR=.secrets/kinlin-dev-yourname
KINLIN_ENVIRONMENT=development
KINLIN_SPRING_PROFILE=compose
KINLIN_DB_NAME=kinlin_ai
KINLIN_DB_USER=kinlin_ai
KINLIN_DB_ADMIN_USER=postgres
KINLIN_PUBLIC_ORIGIN=http://localhost:3000
KINLIN_BIND_ADDRESS=127.0.0.1
KINLIN_HTTP_PORT=8080
KINLIN_DEV_PORT=3000

# Required only when the HTTPS gateway is on another host.
KINLIN_GATEWAY_SOURCE_CIDR=

# SQLite is deliberately single-instance until PostgreSQL WorkflowStore exists.
AGENTOS_SQLITE_BUSY_TIMEOUT_MS=5000

# Optional resource overrides.
KINLIN_BACKEND_CPUS=2.0
KINLIN_BACKEND_MEMORY=2g
KINLIN_AI_CPUS=4.0
KINLIN_AI_MEMORY=4g
# Provider-private tool continuation state. The payload is encrypted before Redis storage.
PROVIDER_STATE_ENABLED=true
PROVIDER_STATE_TTL_SECONDS=3600
TOOL_RUNTIME_ENABLED=true
