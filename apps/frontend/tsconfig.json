{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@platform": ["src/platform/web/adapter.ts"],
      "@window-controls": ["src/platform/web/windowControlsStub.ts"],
      "@ui-zoom": ["src/platform/web/uiZoomStub.ts"],
      "@fullscreen-hotkey": ["src/platform/web/fullscreenHotkeyStub.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["src/**/*.spec.ts", "src/platform/desktop/**/*.ts", "src/components/desktop/**"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
