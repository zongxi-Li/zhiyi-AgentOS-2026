ARG NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32
ARG NPM_REGISTRY=https://registry.npmjs.org
FROM ${NODE_IMAGE}

ARG NPM_REGISTRY

WORKDIR /app

RUN addgroup -g 10003 -S kinlin \
    && adduser -S -D -H -u 10003 -G kinlin kinlin \
    && mkdir -p /home/kinlin/.npm \
    && chown -R 10003:10003 /app /home/kinlin

ENV HOME=/home/kinlin

COPY --chown=10003:10003 package*.json ./
USER 10003:10003
RUN --mount=type=cache,target=/home/kinlin/.npm,uid=10003,gid=10003 \
    npm ci --registry="${NPM_REGISTRY}" --fetch-retries=5 --fetch-retry-maxtimeout=120000
RUN sha256sum package-lock.json | cut -d ' ' -f 1 > node_modules/.kinlin-package-lock.sha256

COPY --chown=10003:10003 . .
COPY --chown=10003:10003 --chmod=0755 docker-entrypoint-dev.sh /usr/local/bin/kinlin-frontend-dev-entrypoint

ENV DEV_BACKEND_PROXY_TARGET=http://backend:8080

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/kinlin-frontend-dev-entrypoint"]
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
