ARG PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.14.5-slim-trixie@sha256:c845af9399020c7e562969a13689e929074a10fd057acd1b1fad06a2fb068e97
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/agent:/app/agentOS:/app/agentOS/src \
    AGENTOS_PACKS_DIR=/app/agent/packs \
    VIRTUAL_ENV=/opt/kinlin-venv \
    PATH=/opt/kinlin-venv/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
    PIP_CACHE_DIR=/pip-cache

WORKDIR /app

RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends gosu \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10002 kinlin \
    && useradd --uid 10002 --gid 10002 --no-create-home --shell /usr/sbin/nologin kinlin \
    && python -m venv "$VIRTUAL_ENV"

COPY apps/agent/requirements.lock ./agent/requirements.lock
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 120 --retries 10 --resume-retries 20 --require-hashes --only-binary=:all: -r agent/requirements.lock \
    && sha256sum agent/requirements.lock | cut -d ' ' -f 1 > "$VIRTUAL_ENV/.kinlin-requirements.sha256"
COPY apps/agent/requirements.tools.lock ./agent/requirements.tools.lock
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 120 --retries 10 --resume-retries 20 --require-hashes --only-binary=:all: -r agent/requirements.tools.lock \
    && cat agent/requirements.lock agent/requirements.tools.lock \
       | sha256sum \
       | cut -d ' ' -f 1 > "$VIRTUAL_ENV/.kinlin-requirements.sha256"

COPY apps/agent ./agent
COPY apps/agentOS ./agentOS
COPY apps/backend/src ./workspace/backend/src
COPY apps/frontend/src ./workspace/frontend/src
COPY apps/agent/app ./workspace/agent/app
COPY apps/agent/packs ./workspace/agent/packs
COPY apps/agentOS ./workspace/agentOS
COPY apps/agent/docker-entrypoint.sh /usr/local/bin/kinlin-entrypoint
COPY apps/agent/docker-entrypoint-dev.sh /usr/local/bin/kinlin-dev-entrypoint

RUN mkdir -p /app/data /app/logs /app/.cache /pip-cache /run/kinlin-secrets \
    && sed -i 's/su-exec/gosu/g' /usr/local/bin/kinlin-entrypoint \
    && chmod 0755 /usr/local/bin/kinlin-entrypoint /usr/local/bin/kinlin-dev-entrypoint \
    && chown -R 10002:10002 /app /pip-cache /run/kinlin-secrets

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/kinlin-dev-entrypoint"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--reload"]
