# Non-sensitive Windows/Docker Desktop development settings only.
KINLIN_DEPLOYMENT_ID=kinlin-win-dev-001
KINLIN_SECRETS_DIR=.secrets/kinlin-win-dev-001
KINLIN_HTTP_PORT=8080
KINLIN_BACKEND_DEBUG_PORT=18080
KINLIN_AI_DEBUG_PORT=18000
KINLIN_WINDOWS_CHOKIDAR_USEPOLLING=true
KINLIN_WINDOWS_WATCHFILES_FORCE_POLLING=true
KINLIN_WINDOWS_POLL_INTERVAL_MS=1000
KINLIN_PUBLIC_ORIGIN=http://127.0.0.1:8080
AGENTOS_PLANNING_ENTROPY_SIMPLE=2048
AGENTOS_PLANNING_ENTROPY_MEDIUM=4096
AGENTOS_PLANNING_ENTROPY_COMPLEX=8192
AGENTOS_PLANNING_ENTROPY_EXTREME=16384
# Protected deterministic SSE provider; keep disabled outside local acceptance tests.
KINLIN_SSE_TEST_MODE=false
SSE_HEARTBEAT_INTERVAL=15
SSE_IDLE_TIMEOUT=240000
SSE_MAX_DURATION=1800000
PROVIDER_STATE_ENABLED=true
PROVIDER_STATE_TTL_SECONDS=3600
TOOL_RUNTIME_ENABLED=true
