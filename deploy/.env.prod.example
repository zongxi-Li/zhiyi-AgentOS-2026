# Copy this file outside the release package and protect it as deployment state.
KINLIN_DEPLOYMENT_ID=replace-with-stable-deployment-id
KINLIN_SECRETS_DIR=/etc/kinlin-ai/secrets
KINLIN_BIND_ADDRESS=127.0.0.1
KINLIN_HTTP_PORT=8080
KINLIN_PUBLIC_ORIGIN=http://127.0.0.1:8080
KINLIN_ENVIRONMENT=production
KINLIN_DB_NAME=kinlin_ai
KINLIN_DB_USER=kinlin_ai
KINLIN_DB_ADMIN_USER=postgres

# Optional model keys remain external files; never put key values in this file.
DEEPSEEK_API_KEY_FILE=
DASHSCOPE_API_KEY_FILE=
